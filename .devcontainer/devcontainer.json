{
    "name": "RTPINN",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "twxs.cmake",             
            "ms-python.python",
            "ms-toolsai.jupyter",
            "donjayamanne.python-environment-manager"
            ]
        },
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": true,
            "upgradePackages": true
        },
    },
}